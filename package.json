{
  "name": "flexdock",
  "version": "0.0.1",
  "description": "A Lit-based web component dock manager: dockable, splittable, tabbed and floating panes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "build:verify": "npm run lint:naming && npm run lint && npm run test:check && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run build:verify",
    "pack:check": "npm pack --dry-run",
    "start": "npm run build && vite --config harness/vite.config.ts",
    "build:harness": "npm run build && vite build --config harness/vite.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:naming": "node scripts/check-naming.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:check": "tsc -p tsconfig.json --noEmit && tsc -p harness/tsconfig.json && tsc -p e2e/tsconfig.json",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=own",
    "test:e2e:reference": "playwright test --project=reference"
  },
  "keywords": [
    "dock-manager",
    "docking",
    "layout",
    "panes",
    "splitter",
    "tabs",
    "web-components",
    "lit",
    "typescript",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Davidhanson90/flexdock.git"
  },
  "bugs": {
    "url": "https://github.com/Davidhanson90/flexdock/issues"
  },
  "author": "David Graville",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
