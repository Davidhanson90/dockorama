{
  "name": "flexdock",
  "version": "0.1.0",
  "description": "A Lit-based web component dock manager: dockable, splittable, tabbed and floating panes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./skins": {
      "types": "./dist/skins/index.d.ts",
      "import": "./dist/skins/index.js"
    },
    "./skins/*": {
      "types": "./dist/skins/*/index.d.ts",
      "import": "./dist/skins/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/skins/*/index.js",
    "./dist/skins/default/skin.js"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json && ngc -p tsconfig.angular.json",
    "build:verify": "npm run lint:naming && npm run check:api && npm run lint && npm run test:check && npm run build && npm run test:coverage",
    "prepublishOnly": "npm run build:verify",
    "pack:check": "npm pack --dry-run",
    "start": "npm run build && vite --config harness/vite.config.ts",
    "bench": "node scripts/bench.mjs",
    "build:harness": "npm run build && vite build --config harness/vite.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:naming": "node scripts/check-naming.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.angular.json --noEmit && tsc -p harness/tsconfig.json && tsc -p e2e/tsconfig.json",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=own",
    "check:api": "node scripts/check-api-overlap.mjs"
  },
  "keywords": [
    "dock-manager",
    "docking",
    "layout",
    "panes",
    "splitter",
    "tabs",
    "web-components",
    "lit",
    "typescript",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Davidhanson90/flexdock.git"
  },
  "bugs": {
    "url": "https://github.com/Davidhanson90/flexdock/issues"
  },
  "author": "David Graville",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/compiler-cli": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3",
    "@angular/core": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  }
}
