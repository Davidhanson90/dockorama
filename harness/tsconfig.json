{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "experimentalDecorators": true,
    "paths": { "flexdock": ["../src/index.ts"], "flexdock/skins": ["../src/skins/index.ts"], "flexdock/skins/*": ["../src/skins/*/index.ts"], "flexdock/*": ["../src/*.ts"] }
  },
  "include": ["./**/*.ts"]
}
